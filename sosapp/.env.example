# Copy to .env and fill in. Never commit .env.
# dev or prod (dev is reserved for pointing Firebase SDKs at local emulators).
ENV=prod
# Base URL of the NestJS API (services/api).
# Android emulator -> your PC: http://10.0.2.2:4000/
# Physical phone: your PC's LAN IP, e.g. http://192.168.1.10:4000/
# Deployed: https://<your-api-host>/
API_URL=http://10.0.2.2:4000/
# Firebase project ID (Project settings > General).
FIREBASE_PROJECT_ID=
# Restrict this key in Google Cloud Console by Android package name + SHA-1
# and to the Maps SDK, Places, Directions, Geocoding and Distance Matrix APIs.
GOOGLE_MAPS_API_KEY=
