# Copy to .env and fill in. Never commit .env.
# dev = call the local Firebase emulator, anything else = deployed API.
ENV=prod
# Firebase project ID (Project settings > General).
FIREBASE_PROJECT_ID=
# Region where Cloud Functions are deployed.
FUNCTIONS_REGION=us-central1
# Host of the Functions emulator when ENV=dev. 10.0.2.2 = your PC from the
# Android emulator; use your PC's LAN IP for a physical phone.
EMULATOR_HOST=10.0.2.2
# Restrict this key in Google Cloud Console by Android package name + SHA-1
# and to the Maps SDK, Places, Directions, Geocoding and Distance Matrix APIs.
GOOGLE_MAPS_API_KEY=
