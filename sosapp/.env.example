# Copy to .env and fill in. Never commit .env.
# EXPO_PUBLIC_* values are inlined into the app bundle: they are public.

# dev or prod.
EXPO_PUBLIC_APP_ENV=prod
# Base URL of the NestJS API (services/api).
# Android emulator -> your PC: http://10.0.2.2:4000/
# Physical phone: your PC's LAN IP, e.g. http://192.168.1.10:4000/
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/
# Two Google Maps keys:
# 1) Native map (Maps SDK for Android). Restrict by "Android apps"
#    (package com.sosapp + SHA-1) and to "Maps SDK for Android" only.
#    Not EXPO_PUBLIC: it goes into AndroidManifest at build time.
GOOGLE_MAPS_ANDROID_API_KEY=
# 2) Web service calls made with fetch (Geocoding, Directions, Distance Matrix,
#    Places). Android-app restrictions do NOT work for these HTTP calls, so
#    restrict this key by API only. It ships in the bundle; plan to proxy these
#    calls through services/api later.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: path to google-services.json (defaults to ./google-services.json).
# On EAS Build, create a file variable GOOGLE_SERVICES_JSON instead.
# GOOGLE_SERVICES_JSON=
