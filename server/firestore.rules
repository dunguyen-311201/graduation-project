rules_version = '2';

// Clients read their own data; business state is written only by the NestJS
// API through the Admin SDK, which bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function changes(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    match /users/{userId} {
      allow read: if signedIn();

      // Self sign-up as a requester or as a center awaiting approval.
      // Workers are created by the API (Admin SDK).
      allow create: if isOwner(userId)
        && request.resource.data.get('role', 'user') in ['user', 'center']
        && request.resource.data.get('statusRegistration', 'pending') != 'approved';

      // Users may edit their own profile but never their role or approval.
      allow update: if isOwner(userId)
        && !changes(['role', 'statusRegistration', 'centerID']);
    }

    // Written only by the NestJS API (LLD section 7).
    match /requests/{id} {
      allow read: if signedIn() && (
        request.auth.uid in resource.data.participantIds ||
        request.auth.uid in resource.data.notifiedCenterIds
      );
      allow write: if false;
    }

    match /assignments/{id} {
      allow read: if signedIn() && (
        request.auth.uid == resource.data.responderId ||
        request.auth.uid == resource.data.centerId
      );
      allow write: if false;
    }

    match /responders/{id} {
      allow read: if signedIn() && (
        request.auth.uid == id ||
        request.auth.uid == resource.data.centerId
      );
      allow write: if false;
    }

    // Written by the API; users may dismiss their own.
    match /notifications/{id} {
      allow read, delete: if signedIn() && request.auth.uid == resource.data.userID;
    }

    // Everything else is denied by default.
  }
}
