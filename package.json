{
  "name": "sos-app",
  "private": true,
  "description": "SOS rescue app: Expo mobile app, NestJS API and shared packages (Turborepo).",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev:api": "turbo run dev --filter=@sos/api",
    "dev:mobile": "pnpm --filter @sos/mobile start",
    "android": "pnpm --filter @sos/mobile android"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  }
}
