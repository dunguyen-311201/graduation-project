{
  "name": "@sos/api",
  "version": "0.1.0",
  "private": true,
  "description": "SOS App backend (NestJS). Replaces server/functions, see docs/04-adr/0011.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "node --watch --import @swc-node/register/esm-register src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.2",
    "@swc/core": "^1.16.20",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "typescript": "^5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
