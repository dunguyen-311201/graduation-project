# Copy to .env for local runs. In deployed environments set these as secrets.
APP_ENV=dev
PORT=4000
# Firebase project ID of the new project.
FIREBASE_PROJECT_ID=
# Service account JSON for the Admin SDK (raw JSON or base64). Create it in
# Firebase console > Project settings > Service accounts, store it only in the
# hosting provider / Doppler. Leave empty locally to use
# `gcloud auth application-default login` or the emulators below.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Uncomment to use the Firebase emulators instead of the real project.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
CORS_ORIGINS=
